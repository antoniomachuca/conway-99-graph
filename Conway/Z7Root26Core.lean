import Std.Sat.CNF.Basic

namespace ConwayRoot26Pilot

open Std.Sat

abbrev Lit := Nat × Bool

def Holds (p : Nat → Bool) (c : CNF.Clause Nat) : Prop := c.eval p = true

instance (p : Nat → Bool) (c : CNF.Clause Nat) : Decidable (Holds p c) :=
  inferInstanceAs (Decidable (c.eval p = true))

theorem splitClause {p : Nat → Bool} {l : Lit} {c : CNF.Clause Nat}
    (h : Holds p (l :: c)) : p l.1 = l.2 ∨ Holds p c := by
  simpa only [Holds, CNF.Clause.eval_cons, Bool.or_eq_true, beq_iff_eq] using h

theorem emptyFalse {p : Nat → Bool} (h : Holds p []) : False := by
  cases h

theorem deniedLiteral {p : Nat → Bool} {c : CNF.Clause Nat} {l : Lit}
    (h : ¬ Holds p c) (hm : l ∈ c) : p l.1 ≠ l.2 := by
  intro heq
  apply h
  exact List.any_eq_true.mpr ⟨l, hm, by simpa using heq⟩

theorem flipOfNe {x b : Bool} (h : x ≠ b) : x = !b := by
  cases x <;> cases b <;> simp_all

theorem initialClause {p : Nat → Bool} {f : CNF Nat}
    (h : f.eval p = true) (i : Nat) (hi : i < f.clauses.size) :
    Holds p f.clauses[i] :=
  Array.all_eq_true.mp h i hi

