theorem all_of_mem {α : Type} {p : α → Bool} {l : List α} {a : α}
    (hall : l.all p = true) (ha : a ∈ l) : p a = true := by
  have := (List.all_eq_true (p := p) (l := l)).1 hall a ha
  simpa using this

/-- Bridge: array bang-lookup equals getD of the underlying list. -/
theorem array_getElem!_eq_getD (arr : Array Nat) (i : Nat) :
    arr[i]! = arr.toList.getD i 0 := by
  rw [List.getD_eq_getElem?_getD, Array.getElem?_toList]
  rcases Nat.lt_or_ge i arr.size with h | h
  · rw [getElem!_pos arr i h, getElem?_pos arr i h]
    rfl
  · rw [getElem!_neg arr i (by omega : ¬ i < arr.size),
        getElem?_neg arr i (by omega : ¬ i < arr.size)]
    rfl

/-- getD of a list append, left part. -/
theorem getD_append_left' (l₁ l₂ : List Nat) (k : Nat) (hk : k < l₁.length) :
    (l₁ ++ l₂).getD k 0 = l₁.getD k 0 := by
  rw [List.getD_eq_getElem?_getD, List.getD_eq_getElem?_getD,
      List.getElem?_append_left hk]

/-- getD of a list append, right part. -/
theorem getD_append_right' (l₁ l₂ : List Nat) (k : Nat) (hk : l₁.length ≤ k) :
    (l₁ ++ l₂).getD k 0 = l₂.getD (k - l₁.length) 0 := by
  rw [List.getD_eq_getElem?_getD, List.getD_eq_getElem?_getD,
      List.getElem?_append_right hk]

/-- Block indexing through a flatMap of equal-length blocks. -/
theorem flatMap_getD_block {α : Type} (l : List α) (g : α → List Nat) (n : Nat)
    (hlen : ∀ x ∈ l, (g x).length = n) (i j : Nat)
    (hi : i < l.length) (hj : j < n) (d : α) :
    (l.flatMap g).getD (i * n + j) 0 = (g (l.getD i d)).getD j 0 := by
  have aux : ∀ l : List α, (∀ x ∈ l, (g x).length = n) → ∀ i,
      i < l.length → (l.flatMap g).getD (i * n + j) 0 = (g (l.getD i d)).getD j 0 := by
    intro l
    induction l with
    | nil => intro _ i hi; exact absurd (by simpa using hi) (Nat.not_lt_zero i)
    | cons x xs ih =>
      intro hlen i hi
      have hxn : (g x).length = n := hlen x (by simp)
      have hlen' : ∀ x' ∈ xs, (g x').length = n := fun x' h => hlen x' (by simp [h])
      rw [List.flatMap_cons]
      cases i with
      | zero =>
        rw [Nat.zero_mul, Nat.zero_add,
            getD_append_left' (g x) (xs.flatMap g) j (by rw [hxn]; exact hj),
            List.getD_cons_zero]
      | succ i =>
        have hi' : i < xs.length := by
          have h := hi; simp only [List.length_cons] at h; omega
        rw [getD_append_right' (g x) (xs.flatMap g) ((i + 1) * n + j)
            (by rw [hxn, Nat.succ_mul]; omega)]
        have he : (i + 1) * n + j - (g x).length = i * n + j := by
          rw [hxn, Nat.succ_mul]; omega
        rw [he, List.getD_cons_succ, ih hlen' i hi']
  exact aux l hlen i hi

/-- getD over List.range. -/
theorem getD_range {i n : Nat} (h : i < n) : (List.range n).getD i 0 = i := by
  rw [List.getD_eq_getElem?_getD, List.getElem?_range h]
  rfl

/-- getD over List.map. -/
theorem getD_map {α β : Type} (l : List α) (f : α → β) (i : Nat) (d : α) (d' : β)
    (hi : i < l.length) :
    (l.map f).getD i d' = f (l.getD i d) := by
  rw [List.getD_eq_getElem?_getD, List.getD_eq_getElem?_getD, List.getElem?_map,
      List.getElem?_eq_getElem hi]
  rfl

/-- Pointwise congruence for foldl sums. -/
theorem foldl_congr {α : Type} (f g : α → Nat) (l : List α)
    (h : ∀ x ∈ l, f x = g x) :
    l.foldl (fun acc x => acc + f x) 0 = l.foldl (fun acc x => acc + g x) 0 := by
  induction l with
  | nil => rfl
  | cons x xs ih =>
    rw [foldl_cons, foldl_cons, h x (by simp),
        ih (fun y hy => h y (by simp [hy]))]

/-- foldl of a constant summand. -/
theorem foldl_const {α : Type} (l : List α) (c : Nat) :
    l.foldl (fun acc _ => acc + c) 0 = c * l.length := by
  induction l with
  | nil => rfl
  | cons x xs ih =>
    rw [foldl_cons, ih, List.length_cons, Nat.mul_succ]
    omega

/-- The y-th non-edge pair. -/
def nePair (y : Fin 84) : Nat × Nat := nePairs.getD y.val (0, 0)

theorem nePairs_length : nePairs.length = 84 := by decide +kernel

theorem M_val_eq (a b : Fin 14) :
    M_val a b = if a.val != b.val && a.val / 2 == b.val / 2 then 1 else 0 := by
  unfold M_val
  rw [array_getElem!_eq_getD, M_arr_toList]
  unfold genM
  rw [flatMap_getD_block (List.range 14) _ 14
        (fun x _ => by simp [List.length_map]) a.val b.val
        (by simpa using a.isLt) b.isLt 0,
      getD_range a.isLt,
      getD_map (List.range 14) _ b.val 0 0 (by simpa using b.isLt),
      getD_range b.isLt]

theorem B_val_eq (a : Fin 14) (y : Fin 84) : B_val a y = ind a.val (nePair y) := by
  unfold B_val
  rw [array_getElem!_eq_getD, B_arr_toList]
  unfold genB
  rw [flatMap_getD_block (List.range 14) _ 84
        (fun x _ => by simp [List.length_map, nePairs_length]) a.val y.val
        (by simpa using a.isLt) y.isLt 0,
      getD_range a.isLt,
      getD_map nePairs (ind a.val) y.val (0, 0) 0
        (by rw [nePairs_length]; exact y.isLt)]
  rfl

theorem K_val_eq (y z : Fin 84) : K_val y z = kEntry (nePair y) (nePair z) := by
  unfold K_val
  rw [array_getElem!_eq_getD, K_arr_toList]
  unfold genK
  rw [flatMap_getD_block nePairs _ 84
        (fun x _ => by simp [List.length_map, nePairs_length]) y.val z.val
        (by rw [nePairs_length]; exact y.isLt) z.isLt (0, 0),
      getD_map nePairs _ z.val (0, 0) 0
        (by rw [nePairs_length]; exact z.isLt)]
  rfl

theorem finRange84_map_nePair : (List.finRange 84).map nePair = nePairs := by
  decide +kernel

theorem nePair_mem (y : Fin 84) : nePair y ∈ nePairs := by
  rw [← finRange84_map_nePair]
  exact List.mem_map.mpr ⟨y, List.mem_finRange _, rfl⟩

theorem fsum84_nePair (g : Nat × Nat → Nat) :
    (List.finRange 84).foldl (fun acc y => acc + g (nePair y)) 0 =
    nePairs.foldl (fun acc p => acc + g p) 0 := by
  rw [← finRange84_map_nePair, List.foldl_map]

/-- First index at which p occurs in nePairs. -/
def pairIndexGo (p : Nat × Nat) : List (Nat × Nat) → Nat → Nat
  | [], acc => acc
  | q :: rest, acc => if q == p then acc else pairIndexGo p rest (acc + 1)

def pairIndex (p : Nat × Nat) : Nat := pairIndexGo p nePairs 0

theorem pairIndex_check :
    (List.finRange 84).all (fun y => pairIndex (nePair y) == y.val) = true := by
  decide +kernel

theorem nePair_inj {y z : Fin 84} (h : nePair y = nePair z) : y = z := by
  have hy := all_of_mem pairIndex_check (List.mem_finRange y)
  have hz := all_of_mem pairIndex_check (List.mem_finRange z)
  simp only [beq_iff_eq] at hy hz
  apply Fin.ext
  rw [← hy, ← hz, h]

/-- Bool-if on Fin equality equals Prop-if. -/
theorem fin_beq_if {n : Nat} (a b : Fin n) (x y : Nat) :
    (if a == b then x else y) = if a = b then x else y := by
  cases e : (a == b) with
  | false =>
    have hne : a ≠ b := by
      intro h2
      have hb : (a == b) = true := beq_iff_eq.mpr h2
      rw [e] at hb
      exact Bool.noConfusion hb
    show y = if a = b then x else y
    rw [if_neg hne]
  | true =>
    have he : a = b := beq_iff_eq.mp e
    show x = if a = b then x else y
    rw [if_pos he]

/-- Squaring a binary number is idempotent. -/
theorem mul_self_le_one {n : Nat} (h : n ≤ 1) : n * n = n := by
  cases n with
  | zero => rfl
  | succ n =>
    cases n with
    | zero => rfl
    | succ n => omega

/-- Block decomposition of the adjacency matrix. -/
def block_A (X : Matrix 84 84) : Matrix99 Nat :=
  fun i j =>
    if h1 : i.val = 0 then
      if h2 : j.val = 0 then 0
      else if h3 : j.val ≤ 14 then 1
      else 0
    else if h4 : i.val ≤ 14 then
      if h5 : j.val = 0 then 1
      else if h6 : j.val ≤ 14 then 
        M_val ⟨i.val - 1, by have : i.val < 99 := i.isLt; omega⟩ ⟨j.val - 1, by have : j.val < 99 := j.isLt; omega⟩
      else 
        B_val ⟨i.val - 1, by have : i.val < 99 := i.isLt; omega⟩ ⟨j.val - 15, by have : j.val < 99 := j.isLt; omega⟩
    else
      if h7 : j.val = 0 then 0
      else if h8 : j.val ≤ 14 then 
        B_val ⟨j.val - 1, by have : j.val < 99 := j.isLt; omega⟩ ⟨i.val - 15, by have : i.val < 99 := i.isLt; omega⟩
      else 
        X ⟨i.val - 15, by have : i.val < 99 := i.isLt; omega⟩ ⟨j.val - 15, by have : j.val < 99 := j.isLt; omega⟩


/-- The root vertex 0 of the block decomposition. -/
def rootV : Fin 99 := ⟨0, by decide⟩

/-- Neighbor vertex: a ∈ 0..13 ↦ vertex a+1. -/
def nbrV (a : Fin 14) : Fin 99 := ⟨a.val + 1, by have := a.isLt; omega⟩

/-- Γ₂ vertex: y ∈ 0..83 ↦ vertex y+15. -/
def farV (y : Fin 84) : Fin 99 := ⟨y.val + 15, by have := y.isLt; omega⟩

theorem rootV_val : rootV.val = 0 := rfl

theorem nbrV_val (a : Fin 14) : (nbrV a).val = a.val + 1 := rfl

theorem farV_val (y : Fin 84) : (farV y).val = y.val + 15 := rfl

theorem nbrV_ne_zero_val (a : Fin 14) : ¬ (nbrV a).val = 0 := by
  rw [nbrV_val]; omega

theorem nbrV_val_le (a : Fin 14) : (nbrV a).val ≤ 14 := by
  rw [nbrV_val]; have := a.isLt; omega

theorem farV_ne_zero_val (y : Fin 84) : ¬ (farV y).val = 0 := by
  rw [farV_val]; omega

theorem farV_val_gt (y : Fin 84) : ¬ (farV y).val ≤ 14 := by
  rw [farV_val]; have := y.isLt; omega

theorem nbrV_inj {a b : Fin 14} (h : nbrV a = nbrV b) : a = b := by
  have e := congrArg Fin.val h
  rw [nbrV_val, nbrV_val] at e
  apply Fin.ext
  omega

theorem farV_inj {y z : Fin 84} (h : farV y = farV z) : y = z := by
  have e := congrArg Fin.val h
  rw [farV_val, farV_val] at e
  apply Fin.ext
  omega

theorem rootV_ne_nbrV (b : Fin 14) : rootV ≠ nbrV b := fun e =>
  absurd (congrArg Fin.val e) (by rw [rootV_val, nbrV_val]; omega)

theorem rootV_ne_farV (z : Fin 84) : rootV ≠ farV z := fun e =>
  absurd (congrArg Fin.val e) (by rw [rootV_val, farV_val]; omega)

theorem nbrV_ne_farV (b : Fin 14) (z : Fin 84) : nbrV b ≠ farV z := fun e =>
  absurd (congrArg Fin.val e)
    (by rw [nbrV_val, farV_val]; have := b.isLt; have := z.isLt; omega)

/-- The 99 vertices split as root ++ neighbors ++ far vertices. -/
theorem finRange99_split :
    List.finRange 99 =
      rootV :: ((List.finRange 14).map nbrV ++ (List.finRange 84).map farV) := by
  decide +kernel

/-- Sums over Fin 99 split along the block decomposition. -/
theorem sum99_split (f : Fin 99 → Nat) :
    (List.finRange 99).foldl (fun acc k => acc + f k) 0 =
      f rootV + (List.finRange 14).foldl (fun acc a => acc + f (nbrV a)) 0 +
        (List.finRange 84).foldl (fun acc y => acc + f (farV y)) 0 := by
  rw [finRange99_split, foldl_cons, List.foldl_append, foldl_add,
      List.foldl_map, List.foldl_map, Nat.add_assoc]

/-- Every Fin 99 vertex is the root, a neighbor, or a far vertex. -/
theorem fin99_cases (i : Fin 99) :
    i = rootV ∨ (∃ a, i = nbrV a) ∨ (∃ y, i = farV y) := by
  have hi := i.isLt
  rcases Nat.lt_or_ge i.val 15 with h | h
  · rcases Nat.eq_zero_or_pos i.val with hz | hp
    · left
      apply Fin.ext
      exact hz
    · right; left
      refine ⟨⟨i.val - 1, by omega⟩, ?_⟩
      apply Fin.ext
      show i.val = i.val - 1 + 1
      omega
  · right; right
    refine ⟨⟨i.val - 15, by omega⟩, ?_⟩
    apply Fin.ext
    show i.val = i.val - 15 + 15
    omega

/-- Nine block evaluations of block_A on the canonical regions. -/
theorem eval_rr (X : Matrix 84 84) : block_A X rootV rootV = 0 := by
  unfold block_A
  rw [dif_pos rootV_val, dif_pos rootV_val]

theorem eval_rn (X : Matrix 84 84) (b : Fin 14) : block_A X rootV (nbrV b) = 1 := by
  unfold block_A
  rw [dif_pos rootV_val, dif_neg (nbrV_ne_zero_val b), dif_pos (nbrV_val_le b)]

theorem eval_rf (X : Matrix 84 84) (z : Fin 84) : block_A X rootV (farV z) = 0 := by
  unfold block_A
  rw [dif_pos rootV_val, dif_neg (farV_ne_zero_val z), dif_neg (farV_val_gt z)]

theorem eval_nr (X : Matrix 84 84) (a : Fin 14) : block_A X (nbrV a) rootV = 1 := by
  unfold block_A
  rw [dif_neg (nbrV_ne_zero_val a), dif_pos (nbrV_val_le a), dif_pos rootV_val]

theorem eval_nn (X : Matrix 84 84) (a b : Fin 14) :
    block_A X (nbrV a) (nbrV b) = M_val a b := by
  unfold block_A
  rw [dif_neg (nbrV_ne_zero_val a), dif_pos (nbrV_val_le a),
      dif_neg (nbrV_ne_zero_val b), dif_pos (nbrV_val_le b)]
  show M_val ⟨(nbrV a).val - 1, _⟩ ⟨(nbrV b).val - 1, _⟩ = M_val a b
  congr 1 <;> apply Fin.ext <;> simp [nbrV_val]

theorem eval_nf (X : Matrix 84 84) (a : Fin 14) (z : Fin 84) :
    block_A X (nbrV a) (farV z) = B_val a z := by
  unfold block_A
  rw [dif_neg (nbrV_ne_zero_val a), dif_pos (nbrV_val_le a),
      dif_neg (farV_ne_zero_val z), dif_neg (farV_val_gt z)]
  show B_val ⟨(nbrV a).val - 1, _⟩ ⟨(farV z).val - 15, _⟩ = B_val a z
  congr 1 <;> apply Fin.ext <;> simp [nbrV_val, farV_val]

theorem eval_fr (X : Matrix 84 84) (y : Fin 84) : block_A X (farV y) rootV = 0 := by
  unfold block_A
  rw [dif_neg (farV_ne_zero_val y), dif_neg (farV_val_gt y), dif_pos rootV_val]

theorem eval_fn (X : Matrix 84 84) (y : Fin 84) (b : Fin 14) :
    block_A X (farV y) (nbrV b) = B_val b y := by
  unfold block_A
  rw [dif_neg (farV_ne_zero_val y), dif_neg (farV_val_gt y),
      dif_neg (nbrV_ne_zero_val b), dif_pos (nbrV_val_le b)]
  show B_val ⟨(nbrV b).val - 1, _⟩ ⟨(farV y).val - 15, _⟩ = B_val b y
  congr 1 <;> apply Fin.ext <;> simp [nbrV_val, farV_val]

theorem eval_ff (X : Matrix 84 84) (y z : Fin 84) :
    block_A X (farV y) (farV z) = X y z := by
  unfold block_A
  rw [dif_neg (farV_ne_zero_val y), dif_neg (farV_val_gt y),
      dif_neg (farV_ne_zero_val z), dif_neg (farV_val_gt z)]
  show X ⟨(farV y).val - 15, _⟩ ⟨(farV z).val - 15, _⟩ = X y z
  congr 1 <;> apply Fin.ext <;> simp [farV_val]

/-- The SRG right-hand side as an if on equality. -/
theorem targetRHS_eq (i j : Fin 99) :
    targetRHS i j = if i = j then 14 else 2 := by
  rw [← fin_beq_if i j 14 2]
  cases h : (i == j)
  · have hne : i ≠ j := by
      intro e
      have hb : (i == j) = true := beq_iff_eq.mpr e
      rw [h] at hb
      exact Bool.noConfusion hb
    rw [if_neg Bool.false_ne_true]
    exact targetRHS_off_diag i j hne
  · have he : i = j := beq_iff_eq.mp h
    rw [if_pos rfl]
    exact (congrArg (fun k => targetRHS i k) he).symm.trans (targetRHS_diag i)

/-- C1: M has zero diagonal. -/
theorem M_diag : ∀ a : Fin 14, M_val a a = 0 := by decide +kernel

/-- C2: M is symmetric. -/
theorem M_symm : ∀ a b : Fin 14, M_val a b = M_val b a := by decide +kernel

/-- C3: M entries are at most 1. -/
theorem M_le_one : ∀ a b : Fin 14, M_val a b ≤ 1 := by decide +kernel

/-- C4: B entries are at most 1. -/
theorem B_le_one : ∀ a : Fin 14, ∀ y : Fin 84, B_val a y ≤ 1 := by
  intro a y
  rw [B_val_eq]
  unfold ind
  cases h : (a.val == (nePair y).1 || a.val == (nePair y).2) <;> simp [h]

/-- C5: each column of M sums to 1. -/
theorem M_colsum : ∀ b : Fin 14, fsum 14 (fun a => M_val a b) = 1 := by
  decide +kernel

/-- C5': each row of M sums to 1. -/
theorem M_rowsum : ∀ a : Fin 14, fsum 14 (fun c => M_val a c) = 1 := by
  decide +kernel

/-- C6 checker function. -/
def bColsumCheck (p : Nat × Nat) : Bool :=
  (List.finRange 14).foldl (fun acc a => acc + ind a.val p) 0 == 2

/-- C6 checker: every non-edge pair has exactly two endpoints among 14 vertices. -/
theorem bColsum_check : nePairs.all bColsumCheck = true := by
  decide +kernel

/-- C6: each column of B sums to 2. -/
theorem B_colsum : ∀ y : Fin 84, fsum 14 (fun a => B_val a y) = 2 := by
  intro y
  unfold fsum
  rw [foldl_congr _ _ _ (fun a _ => B_val_eq a y)]
  have h := all_of_mem bColsum_check (nePair_mem y)
  unfold bColsumCheck at h
  rw [beq_iff_eq] at h
  exact h

/-- C7 checker entry function. -/
def nnCheckF (a b : Fin 14) : Bool :=
  (1 + (List.finRange 14).foldl
        (fun acc c => acc + mEntry a.val c.val * mEntry c.val b.val) 0 +
    nePairs.foldl (fun acc p => acc + ind a.val p * ind b.val p) 0 +
    mEntry a.val b.val) ==
  (if a == b then 14 else 2)

/-- C7 checker row function. -/
def nnCheckA (a : Fin 14) : Bool := (List.finRange 14).all (nnCheckF a)

/-- C7 checker: the neighbor-neighbor block identity over Fin 14. -/
theorem nn_check : (List.finRange 14).all nnCheckA = true := by
  decide +kernel

/-- C7: the neighbor-neighbor block identity. -/
theorem NN_identity : ∀ a b : Fin 14,
    1 + fsum 14 (fun c => M_val a c * M_val c b) +
      fsum 84 (fun y => B_val a y * B_val b y) + M_val a b =
    if a = b then 14 else 2 := by
  intro a b
  have h1 : (List.finRange 14).all (nnCheckF a) = true :=
    all_of_mem (p := nnCheckA) (l := List.finRange 14) (a := a)
      nn_check (List.mem_finRange a)
  have h := all_of_mem (p := nnCheckF a) (l := List.finRange 14) (a := b)
    h1 (List.mem_finRange b)
  unfold nnCheckF at h
  rw [beq_iff_eq] at h
  rw [fin_beq_if a b 14 2] at h
  have e1 : fsum 14 (fun c => M_val a c * M_val c b) =
      (List.finRange 14).foldl
        (fun acc c => acc + mEntry a.val c.val * mEntry c.val b.val) 0 := by
    unfold fsum
    apply foldl_congr
    intro c _
    rw [M_val_eq, M_val_eq]
    rfl
  have e2 : fsum 84 (fun y => B_val a y * B_val b y) =
      nePairs.foldl (fun acc p => acc + ind a.val p * ind b.val p) 0 := by
    unfold fsum
    rw [foldl_congr (fun y => B_val a y * B_val b y)
          (fun y => ind a.val (nePair y) * ind b.val (nePair y))
          (List.finRange 84) (fun y _ => by rw [B_val_eq, B_val_eq])]
    exact fsum84_nePair (fun p => ind a.val p * ind b.val p)
  have e3 : M_val a b = mEntry a.val b.val := M_val_eq a b
  rw [e1, e2, e3]
  exact h

/-- C8 checker entry function. -/
def kCheckQ (p q : Nat × Nat) : Bool :=
  ((List.finRange 14).foldl (fun acc a => acc + ind a.val p * ind a.val q) 0 +
    kEntry p q) == (if p == q then 14 else 2)

/-- C8 checker row function. -/
def kCheckP (p : Nat × Nat) : Bool := nePairs.all (kCheckQ p)

/-- C8 checker, first half of the pair list. -/
theorem kIdent_check_1 : (nePairs.take 42).all kCheckP = true := by
  decide +kernel

/-- C8 checker, second half of the pair list. -/
theorem kIdent_check_2 : (nePairs.drop 42).all kCheckP = true := by
  decide +kernel

/-- C8 checker: B^T B + K gives the SRG right-hand side over pairs. -/
theorem kIdent_check : nePairs.all kCheckP = true := by
  rw [← List.take_append_drop 42 nePairs, List.all_append,
      kIdent_check_1, kIdent_check_2]
  rfl

/-- C8: B^T B + K = 14 on diagonal, 2 off-diagonal. -/
theorem K_identity : ∀ y z : Fin 84,
    fsum 14 (fun a => B_val a y * B_val a z) + K_val y z =
    if y = z then 14 else 2 := by
  intro y z
  have hp : nePairs.all (kCheckQ (nePair y)) = true :=
    all_of_mem (p := kCheckP) (l := nePairs) (a := nePair y)
      kIdent_check (nePair_mem y)
  have hpq := all_of_mem (p := kCheckQ (nePair y)) (l := nePairs) (a := nePair z)
    hp (nePair_mem z)
  unfold kCheckQ at hpq
  rw [beq_iff_eq] at hpq
  unfold fsum
  rw [foldl_congr (fun a => B_val a y * B_val a z)
        (fun a => ind a.val (nePair y) * ind a.val (nePair z))
        (List.finRange 14) (fun a _ => by rw [B_val_eq, B_val_eq]), K_val_eq]
  have hbeq : (y == z) = (nePair y == nePair z) := by
    cases e1 : (y == z) <;> cases e2 : (nePair y == nePair z)
    · rfl
    · exact Bool.noConfusion
        (e1 ▸ beq_iff_eq.mpr (nePair_inj (beq_iff_eq.mp e2)))
    · exact Bool.noConfusion
        (e2 ▸ beq_iff_eq.mpr (congrArg nePair (beq_iff_eq.mp e1)))
    · rfl
  rw [← fin_beq_if y z 14 2, hbeq]
  exact hpq

theorem block_A_diag (X : Matrix 84 84) (hX : ∀ i : Fin 84, X i i = 0) (i : Fin 99) : block_A X i i = 0 := by
  rcases fin99_cases i with rfl | ⟨a, rfl⟩ | ⟨y, rfl⟩
  · exact eval_rr X
  · rw [eval_nn]
    exact M_diag a
  · rw [eval_ff]
    exact hX y

theorem block_A_symm (X : Matrix 84 84) (hX : ∀ i j : Fin 84, X i j = X j i) (i j : Fin 99) : block_A X i j = block_A X j i := by
  rcases fin99_cases i with rfl | ⟨a, rfl⟩ | ⟨y, rfl⟩ <;>
    rcases fin99_cases j with rfl | ⟨b, rfl⟩ | ⟨z, rfl⟩
  · rw [eval_rr]
  · rw [eval_rn, eval_nr]
  · rw [eval_rf, eval_fr]
  · rw [eval_nr, eval_rn]
  · rw [eval_nn X a b, eval_nn X b a]
    exact M_symm a b
  · rw [eval_nf, eval_fn]
  · rw [eval_fr, eval_rf]
  · rw [eval_fn, eval_nf]
  · rw [eval_ff X y z, eval_ff X z y]
    exact hX y z

theorem block_A_binary (X : Matrix 84 84) (hX : ∀ i j : Fin 84, X i j = 0 ∨ X i j = 1) (i j : Fin 99) : block_A X i j = 0 ∨ block_A X i j = 1 := by
  rcases fin99_cases i with rfl | ⟨a, rfl⟩ | ⟨y, rfl⟩ <;>
    rcases fin99_cases j with rfl | ⟨b, rfl⟩ | ⟨z, rfl⟩
  · rw [eval_rr]; exact Or.inl rfl
  · rw [eval_rn]; exact Or.inr rfl
  · rw [eval_rf]; exact Or.inl rfl
  · rw [eval_nr]; exact Or.inr rfl
  · rw [eval_nn]
    have h := M_le_one a b
    omega
  · rw [eval_nf]
    have h := B_le_one a z
    omega
  · rw [eval_fr]; exact Or.inl rfl
  · rw [eval_fn]
    have h := B_le_one b y
    omega
  · rw [eval_ff]
    exact hX y z

theorem block_A_srg_0_0 (X : Matrix 84 84) :
  (List.finRange 99).foldl (fun acc j => acc + block_A X ⟨0, by omega⟩ j) 0 = 14 := by
  show (List.finRange 99).foldl (fun acc j => acc + block_A X rootV j) 0 = 14
  rw [finRange99_split, foldl_cons, List.foldl_append, foldl_add,
      List.foldl_map, List.foldl_map, eval_rr]
  simp only [eval_rn, eval_rf]
  rw [foldl_const, foldl_const, List.length_finRange, List.length_finRange]

theorem block_A_srg_0_j (X : Matrix 84 84) (j : Fin 99) (hj : j.val > 0) :
  (List.finRange 99).foldl (fun acc k => acc + block_A X ⟨0, by omega⟩ k * block_A X k j) 0 + block_A X ⟨0, by omega⟩ j = 2 := by
  show (List.finRange 99).foldl (fun acc k => acc + block_A X rootV k * block_A X k j) 0 +
      block_A X rootV j = 2
  rcases fin99_cases j with rfl | ⟨b, rfl⟩ | ⟨z, rfl⟩
  · exact absurd hj (by rw [rootV_val]; omega)
  · rw [finRange99_split, foldl_cons, List.foldl_append, foldl_add,
        List.foldl_map, List.foldl_map]
    simp only [eval_rr, eval_rn, eval_rf, eval_nr, eval_nn, eval_nf,
               eval_fr, eval_fn, eval_ff,
               Nat.zero_mul, Nat.mul_zero, Nat.one_mul, Nat.mul_one]
    rw [foldl_const, List.length_finRange]
    have h1 : (List.finRange 14).foldl (fun acc a => acc + M_val a b) 0 = 1 := M_colsum b
    omega
  · rw [finRange99_split, foldl_cons, List.foldl_append, foldl_add,
        List.foldl_map, List.foldl_map]
    simp only [eval_rr, eval_rn, eval_rf, eval_nr, eval_nn, eval_nf,
               eval_fr, eval_fn, eval_ff,
               Nat.zero_mul, Nat.mul_zero, Nat.one_mul, Nat.mul_one]
    rw [foldl_const, List.length_finRange]
    have h2 : (List.finRange 14).foldl (fun acc a => acc + B_val a z) 0 = 2 := B_colsum z
    omega

theorem second_subconstituent_reduction (X : Matrix 84 84) :
  (ConwayAdj (block_A X)) ↔
  ((∀ i : Fin 84, X i i = 0) ∧
   (∀ i j : Fin 84, X i j = X j i) ∧
   (∀ i j : Fin 84, X i j = 0 ∨ X i j = 1) ∧
   (∀ i : Fin 84, (List.finRange 84).foldl (fun acc j => acc + X i j) 0 = 12) ∧
   (∀ i j : Fin 84, (List.finRange 84).foldl (fun acc k => acc + X i k * X k j) 0 + X i j = K_val i j) ∧
   (∀ i : Fin 14, ∀ j : Fin 84,
      (List.finRange 14).foldl (fun acc k => acc + M_val i k * B_val k j) 0 +
      (List.finRange 84).foldl (fun acc k => acc + B_val i k * X k j) 0 = 2 - B_val i j)) := by
  constructor
  · intro h
    obtain ⟨hdia, hsym, hbin, heq⟩ := h
    have xs : ∀ u v : Fin 84, X u v = X v u := fun u v => by
      have e := hsym (farV u) (farV v)
      rw [eval_ff, eval_ff] at e
      exact e
    have xd : ∀ y : Fin 84, X y y = 0 := fun y => by
      have e := hdia (farV y)
      rw [eval_ff] at e
      exact e
    refine ⟨xd, xs, fun y z => ?_, ?_, ?_, ?_⟩
    · have e := hbin (farV y) (farV z)
      rw [eval_ff] at e
      exact e
    · intro y
      have h := heq (farV y) (farV y)
      rw [targetRHS_diag] at h
      unfold Matrix99.mul at h
      rw [finRange99_split, foldl_cons, List.foldl_append, foldl_add,
          List.foldl_map, List.foldl_map] at h
      simp only [eval_rr, eval_rn, eval_rf, eval_nr, eval_nn, eval_nf,
                 eval_fr, eval_fn, eval_ff,
                 Nat.zero_mul, Nat.mul_zero, Nat.one_mul, Nat.mul_one] at h
      rw [foldl_congr (fun a => B_val a y * B_val a y) (fun a => B_val a y)
            (List.finRange 14) (fun a _ => mul_self_le_one (B_le_one a y))] at h
      rw [foldl_congr (fun w => X y w * X w y) (fun w => X y w)
            (List.finRange 84) (fun w _ => by
              rcases hbin (farV y) (farV w) with e | e <;> rw [eval_ff] at e
              · rw [e, Nat.zero_mul]
              · rw [e, Nat.one_mul, ← xs y w, e])] at h
      have hb : (List.finRange 14).foldl (fun acc a => acc + B_val a y) 0 = 2 :=
        B_colsum y
      rw [hb, xd y] at h
      omega
    · intro y z
      have h := heq (farV y) (farV z)
      rw [targetRHS_eq (farV y) (farV z)] at h
      unfold Matrix99.mul at h
      rw [finRange99_split, foldl_cons, List.foldl_append, foldl_add,
          List.foldl_map, List.foldl_map] at h
      simp only [eval_rr, eval_rn, eval_rf, eval_nr, eval_nn, eval_nf,
                 eval_fr, eval_fn, eval_ff,
                 Nat.zero_mul, Nat.mul_zero, Nat.one_mul, Nat.mul_one] at h
      have hk : (List.finRange 14).foldl (fun acc a => acc + B_val a y * B_val a z) 0 +
          K_val y z = if y = z then 14 else 2 := K_identity y z
      have hbeq : (farV y == farV z) = (y == z) := by
        cases e1 : (farV y == farV z) <;> cases e2 : (y == z)
        · rfl
        · exact Bool.noConfusion
            (e1 ▸ beq_iff_eq.mpr (congrArg farV (beq_iff_eq.mp e2)))
        · exact Bool.noConfusion
            (e2 ▸ beq_iff_eq.mpr (farV_inj (beq_iff_eq.mp e1)))
        · rfl
      cases e : (y == z)
      · rw [← fin_beq_if (farV y) (farV z) 14 2, hbeq, e] at h
        rw [if_neg Bool.false_ne_true] at h
        rw [← fin_beq_if y z 14 2, e] at hk
        rw [if_neg Bool.false_ne_true] at hk
        omega
      · rw [← fin_beq_if (farV y) (farV z) 14 2, hbeq, e] at h
        rw [if_pos rfl] at h
        rw [← fin_beq_if y z 14 2, e] at hk
        rw [if_pos rfl] at hk
        omega
    · intro a j
      have h := heq (nbrV a) (farV j)
      rw [targetRHS_eq (nbrV a) (farV j), if_neg (nbrV_ne_farV a j)] at h
      unfold Matrix99.mul at h
      rw [finRange99_split, foldl_cons, List.foldl_append, foldl_add,
          List.foldl_map, List.foldl_map] at h
      simp only [eval_rr, eval_rn, eval_rf, eval_nr, eval_nn, eval_nf,
                 eval_fr, eval_fn, eval_ff,
                 Nat.zero_mul, Nat.mul_zero, Nat.one_mul, Nat.mul_one] at h
      have hb := B_le_one a j
      omega
  · intro h
    obtain ⟨h0, hsX, hbX, hrow, hXX, hlin⟩ := h
    refine ⟨block_A_diag X h0, block_A_symm X hsX, block_A_binary X hbX, ?_⟩
    intro i j
    rw [targetRHS_eq i j]
    rcases fin99_cases i with rfl | ⟨a, rfl⟩ | ⟨y, rfl⟩ <;>
      rcases fin99_cases j with rfl | ⟨b, rfl⟩ | ⟨z, rfl⟩
    · rw [if_pos rfl]
      unfold Matrix99.mul
      rw [finRange99_split, foldl_cons, List.foldl_append, foldl_add,
          List.foldl_map, List.foldl_map]
      simp only [eval_rr, eval_rn, eval_rf, eval_nr, eval_nn, eval_nf,
                 eval_fr, eval_fn, eval_ff,
                 Nat.zero_mul, Nat.mul_zero, Nat.one_mul, Nat.mul_one]
      rw [foldl_const, foldl_const, List.length_finRange, List.length_finRange]
    · rw [if_neg (rootV_ne_nbrV b)]
      unfold Matrix99.mul
      rw [finRange99_split, foldl_cons, List.foldl_append, foldl_add,
          List.foldl_map, List.foldl_map]
      simp only [eval_rr, eval_rn, eval_rf, eval_nr, eval_nn, eval_nf,
                 eval_fr, eval_fn, eval_ff,
                 Nat.zero_mul, Nat.mul_zero, Nat.one_mul, Nat.mul_one]
      rw [foldl_const]
      have h1 : (List.finRange 14).foldl (fun acc a => acc + M_val a b) 0 = 1 :=
        M_colsum b
      omega
    · rw [if_neg (rootV_ne_farV z)]
      unfold Matrix99.mul
      rw [finRange99_split, foldl_cons, List.foldl_append, foldl_add,
          List.foldl_map, List.foldl_map]
      simp only [eval_rr, eval_rn, eval_rf, eval_nr, eval_nn, eval_nf,
                 eval_fr, eval_fn, eval_ff,
                 Nat.zero_mul, Nat.mul_zero, Nat.one_mul, Nat.mul_one]
      rw [foldl_const]
      have h2 : (List.finRange 14).foldl (fun acc a => acc + B_val a z) 0 = 2 :=
        B_colsum z
      omega
    · rw [if_neg (fun e => (rootV_ne_nbrV a) e.symm)]
      unfold Matrix99.mul
      rw [finRange99_split, foldl_cons, List.foldl_append, foldl_add,
          List.foldl_map, List.foldl_map]
      simp only [eval_rr, eval_rn, eval_rf, eval_nr, eval_nn, eval_nf,
                 eval_fr, eval_fn, eval_ff,
                 Nat.zero_mul, Nat.mul_zero, Nat.one_mul, Nat.mul_one]
      rw [foldl_const]
      have h1 : (List.finRange 14).foldl (fun acc c => acc + M_val a c) 0 = 1 :=
        M_rowsum a
      omega
    · have hbeq : (nbrV a == nbrV b) = (a == b) := by
        cases e1 : (nbrV a == nbrV b) <;> cases e2 : (a == b)
        · rfl
        · exact Bool.noConfusion
            (e1 ▸ beq_iff_eq.mpr (congrArg nbrV (beq_iff_eq.mp e2)))
        · exact Bool.noConfusion
            (e2 ▸ beq_iff_eq.mpr (nbrV_inj (beq_iff_eq.mp e1)))
        · rfl
      rw [← fin_beq_if (nbrV a) (nbrV b) 14 2, hbeq]
      cases e : (a == b)
      · rw [if_neg Bool.false_ne_true]
        unfold Matrix99.mul
        rw [finRange99_split, foldl_cons, List.foldl_append, foldl_add,
            List.foldl_map, List.foldl_map]
        simp only [eval_rr, eval_rn, eval_rf, eval_nr, eval_nn, eval_nf,
                   eval_fr, eval_fn, eval_ff,
                   Nat.zero_mul, Nat.mul_zero, Nat.one_mul, Nat.mul_one]
        have h7 := NN_identity a b
        rw [← fin_beq_if a b 14 2, e] at h7
        rw [if_neg Bool.false_ne_true] at h7
        unfold fsum at h7
        rw [show (fun acc k => acc + (fun c => M_val a c * M_val c b) k) =
              (fun acc k => acc + M_val a k * M_val k b) from rfl] at h7
        rw [show (fun acc k => acc + (fun y => B_val a y * B_val b y) k) =
              (fun acc k => acc + B_val a k * B_val b k) from rfl] at h7
        omega
      · rw [if_pos rfl]
        unfold Matrix99.mul
        rw [finRange99_split, foldl_cons, List.foldl_append, foldl_add,
            List.foldl_map, List.foldl_map]
        simp only [eval_rr, eval_rn, eval_rf, eval_nr, eval_nn, eval_nf,
                   eval_fr, eval_fn, eval_ff,
                   Nat.zero_mul, Nat.mul_zero, Nat.one_mul, Nat.mul_one]
        have h7 := NN_identity a b
        rw [← fin_beq_if a b 14 2, e] at h7
        rw [if_pos rfl] at h7
        unfold fsum at h7
        rw [show (fun acc k => acc + (fun c => M_val a c * M_val c b) k) =
              (fun acc k => acc + M_val a k * M_val k b) from rfl] at h7
        rw [show (fun acc k => acc + (fun y => B_val a y * B_val b y) k) =
              (fun acc k => acc + B_val a k * B_val b k) from rfl] at h7
        omega
    · rw [if_neg (nbrV_ne_farV a z)]
      unfold Matrix99.mul
      rw [finRange99_split, foldl_cons, List.foldl_append, foldl_add,
          List.foldl_map, List.foldl_map]
      simp only [eval_rr, eval_rn, eval_rf, eval_nr, eval_nn, eval_nf,
                 eval_fr, eval_fn, eval_ff,
                 Nat.zero_mul, Nat.mul_zero, Nat.one_mul, Nat.mul_one]
      have hl := hlin a z
      have hb := B_le_one a z
      omega
    · rw [if_neg (fun e => (rootV_ne_farV y) e.symm)]
      unfold Matrix99.mul
      rw [finRange99_split, foldl_cons, List.foldl_append, foldl_add,
          List.foldl_map, List.foldl_map]
      simp only [eval_rr, eval_rn, eval_rf, eval_nr, eval_nn, eval_nf,
                 eval_fr, eval_fn, eval_ff,
                 Nat.zero_mul, Nat.mul_zero, Nat.one_mul, Nat.mul_one]
      rw [foldl_const]
      have h2 : (List.finRange 14).foldl (fun acc c => acc + B_val c y) 0 = 2 :=
        B_colsum y
      omega
    · rw [if_neg (fun e => (nbrV_ne_farV b y) e.symm)]
      unfold Matrix99.mul
      rw [finRange99_split, foldl_cons, List.foldl_append, foldl_add,
          List.foldl_map, List.foldl_map]
      simp only [eval_rr, eval_rn, eval_rf, eval_nr, eval_nn, eval_nf,
                 eval_fr, eval_fn, eval_ff,
                 Nat.zero_mul, Nat.mul_zero, Nat.one_mul, Nat.mul_one]
      rw [foldl_congr (fun c => B_val c y * M_val c b)
            (fun c => M_val b c * B_val c y) (List.finRange 14)
            (fun c _ => by rw [M_symm b c]; exact Nat.mul_comm _ _)]
      rw [foldl_congr (fun w => X y w * B_val b w)
            (fun w => B_val b w * X w y) (List.finRange 84)
            (fun w _ => by rw [hsX y w]; exact Nat.mul_comm _ _)]
      have hl := hlin b y
      have hb := B_le_one b y
      omega
    · have hbeq : (farV y == farV z) = (y == z) := by
        cases e1 : (farV y == farV z) <;> cases e2 : (y == z)
        · rfl
        · exact Bool.noConfusion
            (e1 ▸ beq_iff_eq.mpr (congrArg farV (beq_iff_eq.mp e2)))
        · exact Bool.noConfusion
            (e2 ▸ beq_iff_eq.mpr (farV_inj (beq_iff_eq.mp e1)))
        · rfl
      rw [← fin_beq_if (farV y) (farV z) 14 2, hbeq]
      cases e : (y == z)
      · rw [if_neg Bool.false_ne_true]
        unfold Matrix99.mul
        rw [finRange99_split, foldl_cons, List.foldl_append, foldl_add,
            List.foldl_map, List.foldl_map]
        simp only [eval_rr, eval_rn, eval_rf, eval_nr, eval_nn, eval_nf,
                   eval_fr, eval_fn, eval_ff,
                   Nat.zero_mul, Nat.mul_zero, Nat.one_mul, Nat.mul_one]
        have hx := hXX y z
        have hk : (List.finRange 14).foldl (fun acc a => acc + B_val a y * B_val a z) 0 +
            K_val y z = 2 := by
          have h8 := K_identity y z
          rw [← fin_beq_if y z 14 2, e] at h8
          rw [if_neg Bool.false_ne_true] at h8
          exact h8
        omega
      · rw [if_pos rfl]
        unfold Matrix99.mul
        rw [finRange99_split, foldl_cons, List.foldl_append, foldl_add,
            List.foldl_map, List.foldl_map]
        simp only [eval_rr, eval_rn, eval_rf, eval_nr, eval_nn, eval_nf,
                   eval_fr, eval_fn, eval_ff,
                   Nat.zero_mul, Nat.mul_zero, Nat.one_mul, Nat.mul_one]
        have hx := hXX y z
        have hk : (List.finRange 14).foldl (fun acc a => acc + B_val a y * B_val a z) 0 +
            K_val y z = 14 := by
          have h8 := K_identity y z
          rw [← fin_beq_if y z 14 2, e] at h8
          rw [if_pos rfl] at h8
          exact h8
        omega

end Matrix99
