def K_val (i j : Fin 84) : Nat := K_arr[i.val * 84 + j.val]!

/-- Finite sum over Fin n via List.finRange. -/
def fsum (n : Nat) (f : Fin n → Nat) : Nat :=
  (List.finRange n).foldl (fun acc k => acc + f k) 0


/-- Lexicographic non-edge pairs (a < b, a/2 != b/2) of 7K2; there are 84. -/
def nePairs : List (Nat × Nat) :=
  (List.range 14).flatMap fun a =>
    ((List.range 14).filter fun b => decide (a < b) && (a / 2 != b / 2)).map fun b => (a, b)

/-- Indicator that vertex a is an endpoint of pair p. -/
def ind (a : Nat) (p : Nat × Nat) : Nat := if a == p.1 || a == p.2 then 1 else 0

/-- K entry for pairs p q: 12 on diagonal, 2 - (shared vertices) off diagonal. -/
def kEntry (p q : Nat × Nat) : Nat := if p == q then 12 else 2 - (ind p.1 q + ind p.2 q)

/-- Adjacency entry of 7K2 on pairs (2t, 2t+1). -/
def mEntry (u v : Nat) : Nat := if u != v && u / 2 == v / 2 then 1 else 0

/-- M_arr as a generated list: row a, column b. -/
def genM : List Nat := (List.range 14).flatMap fun a =>
  (List.range 14).map fun b => if a != b && a / 2 == b / 2 then 1 else 0

/-- B_arr as a generated list: row a over all non-edge pairs. -/
def genB : List Nat := (List.range 14).flatMap fun a => nePairs.map (ind a)

/-- K_arr as a generated list. -/
def genK : List Nat := nePairs.flatMap fun p => nePairs.map (kEntry p)

theorem M_arr_toList : M_arr.toList = genM := by decide +kernel

theorem B_arr_toList : B_arr.toList = genB := by decide +kernel

theorem K_arr_toList : K_arr.toList = genK := by decide +kernel

